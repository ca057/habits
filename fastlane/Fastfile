default_platform(:ios)

platform :ios do
  desc 'Push a new beta build to TestFlight'
  lane :beta do
    # fix for https://github.com/fastlane/fastlane/issues/29528
    ENV['PATH'] = "#{File.expand_path('../scripts', __dir__)}:#{ENV['PATH']}"

    increment_build_number(xcodeproj: 'Habits.xcodeproj')

    build_app(scheme: 'habits')

    app_store_connect_api_key(
      key_id: ENV['LOCAL_APP_STORE_CONNECT_API_KEY_ID'],
      issuer_id: ENV['LOCAL_APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
      key_content: ENV['LOCAL_APP_STORE_CONNECT_API_KEY']
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )

    commit_version_bump
  end
end

